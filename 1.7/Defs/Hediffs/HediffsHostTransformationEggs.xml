<Defs>

	<HediffDef Name="EggIncubationFailureBase" Abstract="True">
		<hediffClass>HediffWithComps</hediffClass>
		<defaultLabelColor>(170,20,20)</defaultLabelColor>
		<minSeverity>0</minSeverity>
		<initialSeverity>0</initialSeverity>
		<maxSeverity>1</maxSeverity>
		<stages>
			<li>
				<minSeverity>0.001</minSeverity>
				<painOffset>2</painOffset>
				<capMods>
					<li>
						<capacity>Consciousness</capacity>
						<setMax>0.1</setMax>
					</li>
				</capMods>
				<hediffGivers>
					<li Class="HediffGiver_Random">
						<hediff>OrganDecay</hediff>
						<mtbDays>0.4</mtbDays>
						<partsToAffect>
							<li>Stomach</li>
							<li>Anus</li>
							<li>Genitals</li>
							<li>Neck</li>
							<li>Jaw</li>
							<li>Heart</li>
							<li>Liver</li>
							<li>Brain</li>
						</partsToAffect>
						<countToAffect>1</countToAffect>
					</li>
				</hediffGivers>
			</li>
		</stages>
		<comps>
			<li Class="HediffCompProperties_SeverityPerDay">
				<severityPerDay>-0.1</severityPerDay>
			</li>
			<li Class="HediffCompProperties_MessageAfterTicks">
				<ticks>60</ticks>
				<letterLabel>{0_labelShort} rejecting host</letterLabel>
				<letterText>{0_labelShort} is rejecting their implanted Amor Host egg!</letterText>
				<letterType>HostRejection</letterType>
			</li>
		</comps>
	</HediffDef>
	
	<HediffDef Name="QueenEggIncubationFailure" ParentName="EggIncubationFailureBase">
		<defName>QueenEggIncubationFailure</defName>
		<label>Queen egg rejection</label>
		<labelNoun>rejection</labelNoun>
		<description>The Amor Queen egg is rejecting this host body. It will result in a slow and painful death...</description>
		<comps>
			<li Class="EBSGFramework.HediffCompProperties_SeverityByGender">
				<genders>
					<Female>0</Female>
					<Male>1</Male>
				</genders>
			</li>
		</comps>
	</HediffDef>

	<HediffDef Name="HostTypeOverrideFailureBase" Abstract="True">
		<hediffClass>HediffWithComps</hediffClass>
		<defaultLabelColor>(170,20,20)</defaultLabelColor>
		<minSeverity>0</minSeverity>
		<initialSeverity>0</initialSeverity>
		<maxSeverity>1</maxSeverity>
		<stages>
			<li>
				<minSeverity>0.001</minSeverity>
				<painOffset>0.25</painOffset>
			</li>
		</stages>
		<comps>
			<li Class="HediffCompProperties_SeverityPerDay">
				<severityPerDay>0.333</severityPerDay>
			</li>
			<li Class="HediffCompProperties_MessageAfterTicks">
				<ticks>120</ticks>
				<letterLabel>{0_labelShort} incubation failure</letterLabel>
				<letterText>{0_labelShort} was unable to incubate a second Amor Host egg type. They will be in pain for a while, but will recover.</letterText>
				<letterType>HostRejection</letterType>
			</li>
		</comps>
	</HediffDef>

	<HediffDef Name="QueenEggOverrideFailure" ParentName="HostTypeOverrideFailureBase">
		<defName>QueenEggOverrideFailure</defName>
		<label>Queen incubation failure</label>
		<labelNoun>failure</labelNoun>
		<description>The attempt to implant an Amor Queen egg failed, as this pawn already is an Amor Host.  This will cause them pain for a few days, but they will recover.</description>
		<comps>
			<li Class="EBSGFramework.HediffCompProperties_SeverityByGenes">
				<baseSeverity>0</baseSeverity>
				<geneEffects>
					<li>
						<gene>AmorQueenHostBody</gene>
						<effect>0.001</effect>
					</li>
				</geneEffects>
			</li>
		</comps>
	</HediffDef>

	<HediffDef Name="EggIncubationSuccessBase" Abstract="True">
		<hediffClass>HediffWithComps</hediffClass>
		<defaultLabelColor>(203,120,227)</defaultLabelColor>
		<scenarioCanAdd>true</scenarioCanAdd>
		<minSeverity>0</minSeverity>
		<initialSeverity>0.001</initialSeverity>
		<maxSeverity>1.5</maxSeverity>		
		<isBad>false</isBad>
		<tendable>false</tendable>
	</HediffDef>
		
	<HediffDef Name="QueenEggIncubationSuccess" ParentName="EggIncubationSuccessBase">
		<defName>QueenEggIncubationSuccess</defName>
		<label>Queen egg incubation</label>
		<labelNoun>incubation</labelNoun>
		<description>An Amor Queen egg is growing within the host. Unlike a normal pregnancy, this will not result in birth, but will gradually transform the host into an Amor Queen. The incubation process takes approximately 15 days (with default multipliers).</description>
		<comps>
			<li Class="HediffCompProperties_SeverityPerDay">
				<severityPerDay>9</severityPerDay>
				<showHoursToRecover>true</showHoursToRecover>
			</li>
			<li Class="EBSGFramework.HediffCompProperties_SeverityByGenes">
				<baseSeverity>0.001</baseSeverity>
				<geneEffects>
					<li>
						<gene>AmorQueenHostBody</gene>
						<effect>-1</effect>
					</li>
				</geneEffects>
			</li>
			<li Class="EBSGFramework.HediffCompProperties_SeverityByGender">
				<genders>
					<Male>0</Male>
					<Female>1.48</Female>
				</genders>
			</li>
			<li Class="EBSGFramework.HediffCompProperties_CreateOtherHediffs">
				<hediffSets>
					<li>
						<hediffDef>QueenEggIncubation</hediffDef>
						<validSeverity>1.48~1.51</validSeverity>
						<severityPerDay>0</severityPerDay>
						<initialSeverity>0.001</initialSeverity>
					</li>
				</hediffSets>
			</li>
			<li Class="EBSGFramework.HediffCompProperties_RemoveAtSeverities">
				<severity>1.5</severity>
			</li>
		</comps>
		<stages>
			<li>
				<label>incubating egg</label>
			</li>
		</stages>
	</HediffDef>

	<HediffDef Name="EggIncubationBase" Abstract="True">
		<hediffClass>HediffWithComps</hediffClass>
		<defaultLabelColor>(203,120,227)</defaultLabelColor>
		<scenarioCanAdd>true</scenarioCanAdd>
		<minSeverity>0</minSeverity>
		<initialSeverity>0.001</initialSeverity>
		<maxSeverity>1.5</maxSeverity>
		<isBad>false</isBad>
		<tendable>false</tendable>
		<comps>
			<li Class="HediffCompProperties_MessageAfterTicks">
				<ticks>60</ticks>
				<letterLabel>{0_labelShort} impregnated</letterLabel>
				<letterText>{0_labelShort} has been impregnated with an Amor Host egg!</letterText>
				<letterType>HostPregnancy</letterType>
			</li>
		</comps>
	</HediffDef>

	<HediffDef Name="QueenEggIncubation" ParentName="EggIncubationBase">
		<defName>QueenEggIncubation</defName>
		<label>Queen egg incubation</label>
		<labelNoun>incubation</labelNoun>
		<description>An Amor Queen egg is growing within the host. Unlike a normal pregnancy, this will not result in birth, but will gradually transform the host into an Amor Queen. The incubation process takes approximately 15 days (with default multipliers).</description>
		<comps>
			<li Class="AmorTentaculum.HediffCompProperties_MultipliedSeverityPerDay">
				<modSettingMultiplier>hostIncubationSpeedFactor</modSettingMultiplier>
				<baseSeverityPerDay>0.15</baseSeverityPerDay>
			</li>
			<li Class="EBSGFramework.HediffCompProperties_CreateOtherHediffs">
				<hediffSets>
					<li>
						<hediffDef>QueenTransform</hediffDef>
						<validSeverity>1.48~1.51</validSeverity>
						<severityPerDay>0</severityPerDay>
						<initialSeverity>0.1</initialSeverity>
					</li>
					<li>
						<hediffDef>AmorQueenPregnancy</hediffDef>
						<validSeverity>1.48~1.51</validSeverity>
						<severityPerDay>0</severityPerDay>
						<initialSeverity>0.1</initialSeverity>
					</li>
				</hediffSets>
			</li>
		</comps>
		<stages>
			<li>
				<label>incubating egg</label>
			</li>
			<li>
				<label>hatched</label>
				<minSeverity>0.6</minSeverity>
				<hungerRateFactorOffset>0.1</hungerRateFactorOffset>
				<statOffsets>
					<Vulnerability>0.1</Vulnerability>
					<MoveSpeed>-0.01</MoveSpeed>
				</statOffsets>
			</li>
			<li>
				<label>larvae</label>
				<minSeverity>0.65</minSeverity>
				<restFallFactor>1.05</restFallFactor>
				<hungerRateFactorOffset>0.15</hungerRateFactorOffset>
				<statOffsets>
					<PsychicSensitivity>0.1</PsychicSensitivity>
					<Vulnerability>0.2</Vulnerability>
					<MoveSpeed>-0.02</MoveSpeed>
				</statOffsets>
				<hediffGivers>
					<li Class="HediffGiver_Random">
						<hediff>TentacleInfestedStomach</hediff>
						<mtbDays>4</mtbDays>
						<partsToAffect>
							<li>Stomach</li>
						</partsToAffect>
						<countToAffect>1</countToAffect>
					</li>
				</hediffGivers>
				<painOffset>0.02</painOffset>
			</li>
			<li>
				<label>growing</label>
				<minSeverity>0.9</minSeverity>
				<restFallFactor>1.1</restFallFactor>
				<hungerRateFactorOffset>0.3</hungerRateFactorOffset>
				<statOffsets>
					<PsychicSensitivity>0.2</PsychicSensitivity>
					<Vulnerability>0.3</Vulnerability>
					<SexFrequency>0.5</SexFrequency>
					<MoveSpeed>-0.05</MoveSpeed>
				</statOffsets>
				<hediffGivers>
					<li Class="HediffGiver_Random">
						<hediff>TentacleInfestedStomach</hediff>
						<mtbDays>3</mtbDays>
						<partsToAffect>
							<li>Stomach</li>
						</partsToAffect>
						<countToAffect>1</countToAffect>
					</li>
					<li Class="HediffGiver_Random">
						<hediff>TentacleInfestedAnus</hediff>
						<mtbDays>2</mtbDays>
						<partsToAffect>
							<li>Anus</li>
						</partsToAffect>
						<countToAffect>1</countToAffect>
					</li>
				</hediffGivers>
				<painOffset>0.03</painOffset>
			</li>
			<li>
				<label>nearly grown</label>
				<minSeverity>1.3</minSeverity>
				<restFallFactor>1.2</restFallFactor>
				<hungerRateFactorOffset>0.5</hungerRateFactorOffset>
				<statOffsets>
					<PsychicSensitivity>0.3</PsychicSensitivity>
					<Vulnerability>0.5</Vulnerability>
					<MoveSpeed>-0.1</MoveSpeed>
					<SexFrequency>1</SexFrequency>
				</statOffsets>
				<hediffGivers>
					<li Class="HediffGiver_Random">
						<hediff>TentacleInfestedStomach</hediff>
						<mtbDays>0.1</mtbDays>
						<partsToAffect>
							<li>Stomach</li>
						</partsToAffect>
						<countToAffect>1</countToAffect>
					</li>
					<li Class="HediffGiver_Random">
						<hediff>TentacleInfestedVagina</hediff>
						<mtbDays>0.1</mtbDays>
						<partsToAffect>
							<li>Genitals</li>
						</partsToAffect>
						<countToAffect>1</countToAffect>
					</li>
					<li Class="HediffGiver_Random">
						<hediff>TentacleInfestedAnus</hediff>
						<mtbDays>0.1</mtbDays>
						<partsToAffect>
							<li>Anus</li>
						</partsToAffect>
						<countToAffect>1</countToAffect>
					</li>
				</hediffGivers>
				<painOffset>0.1</painOffset>
			</li>
		</stages>
	</HediffDef>

	<HediffDef>
		<defName>TentacleInfestedAnus</defName>
		<hediffClass>HediffWithComps</hediffClass>
		<label>stretched rectum</label>
		<labelNoun>rectum</labelNoun>
		<description>The growing Amor Tentaculum has invaded this part of the Host's body. Their rectum and large intestine are being stretched to accommodate larger and more plentiful tentacle insertions. These processes are uncomfortable.</description>
		<defaultLabelColor>(255,20,147)</defaultLabelColor>
		<minSeverity>0.001</minSeverity>
		<initialSeverity>0.001</initialSeverity>
		<maxSeverity>1</maxSeverity>
		<keepOnBodyPartRestoration>True</keepOnBodyPartRestoration>
		<stages>
			<li>
				<minSeverity>0.001</minSeverity>
				<label>still narrow</label>
				<painOffset>0.05</painOffset>
				<statOffsets>
					<MoveSpeed>-0.01</MoveSpeed>
				</statOffsets>
			</li>
			<li>
				<minSeverity>0.25</minSeverity>
				<label>expanding</label>
				<painOffset>0.2</painOffset>
				<statOffsets>
					<MoveSpeed>-0.02</MoveSpeed>
				</statOffsets>
			</li>
			<li>
				<minSeverity>0.5</minSeverity>
				<label>gaping, painful</label>
				<painOffset>0.3</painOffset>
				<statOffsets>
					<MoveSpeed>-0.03</MoveSpeed>
				</statOffsets>
			</li>
			<li>
				<minSeverity>0.75</minSeverity>
				<label>gaping, acclimating</label>
				<painOffset>0.2</painOffset>
				<statOffsets>
					<MoveSpeed>-0.02</MoveSpeed>
				</statOffsets>
			</li>
			<li>
				<minSeverity>1</minSeverity>
				<label>gaping, accustomed</label>
				<painOffset>0.01</painOffset>
				<statOffsets>
					<TStorage>0.02</TStorage>
					<MoveSpeed>-0.01</MoveSpeed>
				</statOffsets>
			</li>
		</stages>
		<comps>
			<li Class="AmorTentaculum.HediffCompProperties_MultipliedSeverityPerDay">
				<modSettingMultiplier>hostAcclimationSpeedFactor</modSettingMultiplier>
				<baseSeverityPerDay>0.05</baseSeverityPerDay>
			</li>
		</comps>
	</HediffDef>

	<HediffDef>
		<defName>TentacleInfestedStomach</defName>
		<hediffClass>HediffWithComps</hediffClass>
		<label>stretched stomach</label>
		<labelNoun>stomach</labelNoun>
		<description>The growing Amor Tentaculum has invaded this part of the Host's body. Their stomach and throat are being stretched and cleared of acid to provide a better environment for tentacle storage. These processes are uncomfortable.</description>
		<defaultLabelColor>(255,20,147)</defaultLabelColor>
		<minSeverity>0.001</minSeverity>
		<initialSeverity>0.001</initialSeverity>
		<maxSeverity>1</maxSeverity>
		<keepOnBodyPartRestoration>True</keepOnBodyPartRestoration>
		<stages>
			<li>
				<minSeverity>0.001</minSeverity>
				<label>slightly streched</label>
				<painOffset>0.05</painOffset>
				<partEfficiencyOffset>-0.2</partEfficiencyOffset>
				<statOffsets>
					<VEF_FoodCapacityMultiplier>0.2</VEF_FoodCapacityMultiplier>
					<MoveSpeed>-0.01</MoveSpeed>
				</statOffsets>
			</li>
			<li>
				<minSeverity>0.25</minSeverity>
				<label>expanding</label>
				<painOffset>0.2</painOffset>
				<partEfficiencyOffset>-0.3</partEfficiencyOffset>
				<statOffsets>
					<VEF_FoodCapacityMultiplier>0.3</VEF_FoodCapacityMultiplier>
					<MoveSpeed>-0.02</MoveSpeed>
				</statOffsets>
			</li>
			<li>
				<minSeverity>0.5</minSeverity>
				<label>removing stomach acid</label>
				<painOffset>0.3</painOffset>
				<vomitMtbDays>0.08</vomitMtbDays>
				<partEfficiencyOffset>-0.8</partEfficiencyOffset>
				<statOffsets>
					<VEF_FoodCapacityMultiplier>0.5</VEF_FoodCapacityMultiplier>
					<MoveSpeed>-0.03</MoveSpeed>
				</statOffsets>
			</li>
			<li>
				<minSeverity>0.75</minSeverity>
				<label>spacious, acclimating</label>
				<painOffset>0.2</painOffset>
				<partEfficiencyOffset>-0.8</partEfficiencyOffset>
				<statOffsets>
					<VEF_FoodCapacityMultiplier>0.5</VEF_FoodCapacityMultiplier>
					<MoveSpeed>-0.03</MoveSpeed>
				</statOffsets>
			</li>
			<li>
				<minSeverity>1</minSeverity>
				<label>spacious, accustomed</label>
				<painOffset>0.01</painOffset>
				<partEfficiencyOffset>-0.7</partEfficiencyOffset>
				<statOffsets>
					<VEF_FoodCapacityMultiplier>0.5</VEF_FoodCapacityMultiplier>
					<MoveSpeed>-0.02</MoveSpeed>
					<TStorage>0.02</TStorage>
				</statOffsets>
			</li>
		</stages>
		<comps>
			<li Class="AmorTentaculum.HediffCompProperties_MultipliedSeverityPerDay">
				<modSettingMultiplier>hostAcclimationSpeedFactor</modSettingMultiplier>
				<baseSeverityPerDay>0.05</baseSeverityPerDay>
			</li>
		</comps>
	</HediffDef>

	<HediffDef>
		<defName>TentacleInfestedVagina</defName>
		<hediffClass>HediffWithComps</hediffClass>
		<label>stretched womb</label>
		<labelNoun>womb</labelNoun>
		<description>The growing Amor Tentaculum has invaded this part of the Host's body. Their cervix is being stretched to provide better access to their womb, which is also being expanded. These processes are uncomfortable.</description>
		<defaultLabelColor>(255,20,147)</defaultLabelColor>
		<minSeverity>0.001</minSeverity>
		<initialSeverity>0.001</initialSeverity>
		<maxSeverity>1</maxSeverity>
		<keepOnBodyPartRestoration>True</keepOnBodyPartRestoration>
		<stages>
			<li>
				<minSeverity>0.001</minSeverity>
				<label>slightly streched</label>
				<painOffset>0.05</painOffset>
				<statOffsets>
					<MoveSpeed>-0.01</MoveSpeed>
				</statOffsets>
			</li>
			<li>
				<minSeverity>0.25</minSeverity>
				<label>expanding</label>
				<painOffset>0.2</painOffset>
				<partEfficiencyOffset>0.2</partEfficiencyOffset>
				<statOffsets>
					<MoveSpeed>-0.02</MoveSpeed>
				</statOffsets>
			</li>
			<li>
				<minSeverity>0.5</minSeverity>
				<label>opening cervix</label>
				<painOffset>0.5</painOffset>
				<partEfficiencyOffset>0.3</partEfficiencyOffset>
				<statOffsets>
					<MoveSpeed>-0.3</MoveSpeed>
				</statOffsets>
			</li>
			<li>
				<minSeverity>0.75</minSeverity>
				<label>spacious, acclimating</label>
				<painOffset>0.2</painOffset>
				<partEfficiencyOffset>0.5</partEfficiencyOffset>
				<statOffsets>
					<MoveSpeed>-0.03</MoveSpeed>
				</statOffsets>
			</li>
			<li>
				<minSeverity>1</minSeverity>
				<label>spacious, accustomed</label>
				<painOffset>0.01</painOffset>
				<partEfficiencyOffset>0.5</partEfficiencyOffset>
				<statOffsets>
					<TStorage>0.02</TStorage>
					<MoveSpeed>-0.02</MoveSpeed>
				</statOffsets>
			</li>
		</stages>
		<comps>
			<li Class="AmorTentaculum.HediffCompProperties_MultipliedSeverityPerDay">
				<modSettingMultiplier>hostAcclimationSpeedFactor</modSettingMultiplier>
				<baseSeverityPerDay>0.05</baseSeverityPerDay>
			</li>
			<li Class="EBSGFramework.HediffCompProperties_GiveOtherHediffPeriodically">
				<hediff>TentacleStorage</hediff>
				<severity>0.05</severity>
				<interval>5000</interval>
				<bodyParts>
					<li>Genitals</li>
				</bodyParts>
				<validSeverities>0.7~0.723</validSeverities>
			</li>
		</comps>
	</HediffDef>
	
</Defs>
